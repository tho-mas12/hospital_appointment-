# MongoDB Database Connection string
MONGO_URI=mongodb://localhost:27015/hospital-appointment-system

# JSON Web Token Secret
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES=7d

# Port number for Express server
PORT=5000

# Client App URL for CORS permission (e.g. your local frontend URL or Vercel URL)
CLIENT_URL=http://localhost:3000
